<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title or site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or site.title }}">
    <meta name="twitter:description" content="{{ description or site.description }}">
    <link rel="icon" type="image/png" href="/assets/images/favicon-purple.png">
    <link rel="stylesheet" href="/assets/css/site-v2.css">
  </head>
  <body>
    <header class="site-header">
      <div class="nav-wrap">
        <a class="brand" href="/" aria-label="General Folders home">
          <img class="brand-logo" src="/assets/images/gf-logo-horizontal.png" alt="General Folders">
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/company/">Company</a>
          <a href="/blog/">Blog</a>
          <a href="/news/">News</a>
        </nav>
        <div class="nav-actions">
          <a class="button button-primary" href="{{ site.loginUrl }}">Login</a>
          <button class="button button-green" type="button" data-open-sales-modal>Talk to sales</button>
        </div>
      </div>
    </header>

    <main id="main">
      {{ content | safe }}
    </main>

    <div class="modal" data-sales-modal hidden>
      <div class="modal-backdrop" data-close-sales-modal></div>
      <section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="sales-modal-title">
        <button class="modal-close" type="button" aria-label="Close" data-close-sales-modal>×</button>
        <p class="eyebrow">Talk to sales</p>
        <h2 id="sales-modal-title">Let's discuss your data exchange use cases.</h2>
        <p class="modal-intro">Tell us a little about your team and what you are trying to move between companies.</p>
        <form class="sales-form" action="{{ site.requestAccessUrl }}" method="POST">
          <input type="hidden" name="_subject" value="General Folders sales request">
          <p class="form-note form-full">Fields marked <span aria-hidden="true">*</span> are required.</p>
          <label>
            <span>Name <em aria-hidden="true">*</em></span>
            <input name="name" autocomplete="name" required aria-required="true">
          </label>
          <label>
            <span>Email <em aria-hidden="true">*</em></span>
            <input name="email" type="email" autocomplete="email" required aria-required="true">
          </label>
          <label>
            <span>Company <em aria-hidden="true">*</em></span>
            <input name="company" autocomplete="organization" required aria-required="true">
          </label>
          <label>
            <span>LinkedIn</span>
            <input name="linkedin" type="url" autocomplete="url">
          </label>
          <label class="form-full">
            <span>Data exchange needs <em aria-hidden="true">*</em></span>
            <textarea name="needs" rows="5" required aria-required="true"></textarea>
          </label>
          <label class="checkbox-field form-full">
            <input name="contact_permission" type="checkbox" value="yes" required aria-required="true">
            <span>I agree to be contacted by General Folders about my data exchange needs. <em aria-hidden="true">*</em></span>
          </label>
          <button class="button button-primary form-full" type="submit">Send request</button>
        </form>
      </section>
    </div>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-grid">
          <div>
            <h3>News</h3>
            <ul>
              <li><a href="https://medium.com/@GlueOps/general-folders-launches-a-developer-platform-in-days-with-glueops-dcca6132a38d">General Folders launches a developer platform in days with GlueOps</a></li>
              <li><a href="https://beststartup.la/securing-the-cloud-spotlight-on-san-franciscos-innovative-cloud-security-companies/">Securing the Cloud: Spotlight on San Francisco's Innovative Cloud Security Companies</a></li>
              <li><a href="https://www.techstars.com/newsroom/new-class-san-diego-sdsu">Techstars San Diego Powered By San Diego State University Announces Inaugural 2023 Class</a></li>
            </ul>
            <a class="footer-more" href="/news/">More</a>
          </div>
          <div>
            <h3>Company</h3>
            <ul>
              <li><a href="/company/">About</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/news/">News</a></li>
            </ul>
          </div>
          <div>
            <h3>Legal</h3>
            <ul>
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/terms-of-service/">Terms of Service</a></li>
            </ul>
          </div>
          <div>
            <h3>Follow us</h3>
            <ul>
              <li><a href="https://x.com/GeneralFolders">X</a></li>
              <li><a href="https://bsky.app/profile/generalfolders.com">Bluesky</a></li>
              <li><a href="https://www.linkedin.com/company/generalfolders">LinkedIn</a></li>
              <li><a href="https://www.instagram.com/generalfolders.club">Instagram</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">© {% year %} General Folders. All rights reserved.</div>
      </div>
    </footer>
    <script>
      (() => {
        document.querySelectorAll("a[href^='http://'], a[href^='https://']").forEach((link) => {
          const url = new URL(link.href, window.location.href);
          if (url.origin === window.location.origin) return;

          link.target = "_blank";
          link.rel = "noopener noreferrer";
        });

        const modal = document.querySelector("[data-sales-modal]");
        const openers = document.querySelectorAll("[data-open-sales-modal], a[href='#talk-to-sales']");
        const closers = document.querySelectorAll("[data-close-sales-modal]");
        let previousFocus = null;

        const openModal = () => {
          previousFocus = document.activeElement;
          modal.hidden = false;
          document.body.classList.add("modal-open");
          modal.querySelector("input, textarea, button")?.focus();
        };

        const closeModal = () => {
          modal.hidden = true;
          document.body.classList.remove("modal-open");
          previousFocus?.focus?.();
        };

        openers.forEach((opener) => opener.addEventListener("click", (event) => {
          event.preventDefault();
          openModal();
        }));
        closers.forEach((closer) => closer.addEventListener("click", closeModal));
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && !modal.hidden) closeModal();
        });
      })();
    </script>
  </body>
</html>
