---
layout: base.njk
title: Blog — General Folders
description: Insights on B2B data transfer
permalink: /blog/
---
<section class="section page-hero list-hero">
  <div class="content">
    <h1 class="page-title gradient-text">Blog</h1>
    <p class="lead">Insights on B2B data transfer</p>
  </div>
</section>

<section class="section list-section">
  <div class="post-list">
    {% for post in collections.post | reverse %}
      <article class="post-card">
        <p class="meta">
          <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
          {% if post.data.author %}<span class="muted"> · {{ post.data.author }}</span>{% endif %}
        </p>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p class="muted">{{ post.data.description }}</p>
        <a href="{{ post.url }}">Read full article →</a>
      </article>
    {% endfor %}
  </div>
</section>
